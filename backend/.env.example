APP_ENV=local
DATABASE_URL=postgresql+psycopg://ckg:ckg@localhost:5432/ckg
REDIS_URL=redis://localhost:6379/0
ADMIN_EMAIL=admin@ckg.com
ADMIN_PASSWORD=Admin123!
ADMIN_FULL_NAME=Root Admin
# External frontend-dashboard login pool (scope="prod"). Leave blank to skip seeding.
# Must DIFFER from ADMIN_EMAIL — admins.email is unique, so a clashing email
# makes the prod seed a no-op (ON CONFLICT DO NOTHING) and prod login won't work.
# Migration 0019 seeds this password VERBATIM — set a strong, unique value for
# any non-local deploy (the example below is for local dev only).
PROD_ADMIN_EMAIL=prod@ckg.com
PROD_ADMIN_PASSWORD=ProdAdmin123!
PROD_ADMIN_FULL_NAME=Prod Admin
JWT_SECRET=replace-with-32-byte-random-secret-string-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=1440
CRED_ENCRYPTION_KEY=replace-with-fernet-key-from-Fernet.generate_key
# Include the frontend-dashboard origin (:3001 local) so the browser isn't blocked.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
# Reverse proxies in front of the backend. The login rate-limiter reads the
# client IP as the Nth-from-last X-Forwarded-For entry (un-spoofable). Set to the
# number of trusted proxies: 1 for a single nginx (default), 0 if uvicorn is
# exposed directly (ignores XFF, uses the socket peer). A wrong value either lets
# attackers rotate the spoofed IP or buckets every user under the proxy's IP.
TRUSTED_PROXY_COUNT=1
SCRAPERS_ROOT=
SCRAPER_SESSIONS_ROOT=
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=openai
# Explainer-chatbot knowledge packs. Container default is /app/chatbot (baked by
# the Dockerfile); for local dev point it at the repo-root chatbot/ folder.
CHATBOT_DIR=../chatbot
