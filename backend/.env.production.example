# backend/.env on the VPS. Copy to backend/.env and fill real values.
# DATABASE_URL and REDIS_URL are OVERRIDDEN by docker-compose, so leave them
# blank or omit — compose injects the in-network values.

APP_ENV=production

# Admin seeded by alembic migration 0002_seed_admin on first `alembic upgrade head`.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_FULL_NAME=Root Admin

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-48-byte-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=1440

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRED_ENCRYPTION_KEY=replace-with-fernet-key

# JSON list. Must include the origin the BROWSER uses to load the frontend.
# Example IP-only behind host nginx on :80
CORS_ORIGINS=["http://YOUR_VPS_IP"]

LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Leave SCRAPERS_ROOT empty — Dockerfile bakes /app/scrapers and config.py
# auto-resolves it. SCRAPER_SESSIONS_ROOT is set by docker-compose to the
# persistent volume mount; do not set it here.

OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=openai
