# Copy to .env.local for local development:  cp .env.local.example .env.local
# (.env.local is gitignored; this example is committed.)
#
# Base URL of the CKG backend API. REQUIRED in local dev for two reasons:
#
#   1. CSP — next.config.ts adds this origin to the Content-Security-Policy
#      `connect-src`. If unset, the policy is `connect-src 'self'` and the
#      browser BLOCKS every API call ("Network Error" on login), even though
#      lib/env.ts still sends the requests to :8000.
#
#   2. IPv4 — use 127.0.0.1, NOT localhost. uvicorn binds 127.0.0.1 (IPv4);
#      macOS resolves "localhost" to ::1 (IPv6) first, where nothing listens.
#
# Keep opening the app at http://localhost:3000 so the page Origin stays in the
# backend CORS allowlist. Changing this file requires a dev-server restart
# (next.config.ts reads it once at startup).
#
# In production the API is same-origin, so this is left unset there (the origin
# resolves empty and CSP 'self' covers it).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
